    "Raw": {
      "Manual Install": [
        {
          "name": "Google Chrome",
          "url": "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb",
          "install_command": "dpkg -i google-chrome-stable_current_amd64.deb || apt install -f -y",
          "description": "A fast, secure, and reliable web browser."
        },
        {
          "name": "Discord",
          "url": "https://discord.com/api/download?platform=linux&format=deb",
          "install_command": "dpkg -i discord.deb || apt install -f -y",
          "description": "A communication platform for communities and gamers."
        },
        {
          "name": "OpenRGB",
          "url": "https://openrgb.org/releases/release_0.9/openrgb_0.9_amd64_bookworm_b5f46e3.deb",
          "install_command": "dpkg -i openrgb.deb || apt install -f -y",
          "description": "Software to control RGB lighting on devices."
        },
        {
          "name": "Zoom",
          "url": "https://zoom.us/client/latest/zoom_amd64.deb",
          "install_command": "dpkg -i zoom_amd64.deb || apt install -f -y",
          "description": "Video conferencing tool for remote meetings."
        },
        {
          "name": "TeamViewer",
          "url": "https://download.teamviewer.com/download/linux/teamviewer_amd64.deb",
          "install_command": "dpkg -i teamviewer_amd64.deb || apt install -f -y",
          "description": "Remote control and online meeting software."
        },
        {
          "name": "Skype",
          "url": "https://repo.skype.com/latest/skypeforlinux-64.deb",
          "install_command": "dpkg -i skypeforlinux-64.deb || apt install -f -y",
          "description": "Communication tool for video conferencing and instant messaging."
        },
        {
          "name": "Vivaldi",
          "url": "https://downloads.vivaldi.com/stable/vivaldi-stable_6.0.2318.56-1_amd64.deb",
          "install_command": "dpkg -i vivaldi-stable_6.0.2318.56-1_amd64.deb || apt install -f -y",
          "description": "A highly customizable web browser with built-in productivity features."
        },
        {
          "name": "Miniconda3",
          "url": "https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh",
          "install_command": "bash Miniconda3-latest-Linux-x86_64.sh -b -p $HOME/miniconda3 && rm Miniconda3-latest-Linux-x86_64.sh",
          "description": "Miniconda installer for the conda package manager."
        },
        {
          "name": "PHP - Composer",
          "url": "https://getcomposer.org/download/latest-stable/composer.phar",
          "check_command": "composer --version",
          "install_command": "php composer.phar install --no-dev && mv composer.phar /usr/local/bin/composer",
          "description": "Dependency manager for PHP, allowing you to manage libraries and packages."
        },
        {
          "name": "PHP - Stan",
          "url": "https://github.com/phpstan/phpstan/releases/download/2.1.17/phpstan.phar",
          "check_command": "phpstan --version",
          "install_command": "php phpstan.phar install --no-dev && mv phpstan.phar /usr/local/bin/phpstan",
          "description": "Static analysis tool for PHP, helping to find bugs and improve code quality."
        },
        {
          "name": "PHP - MD",
          "url": "https://phpmd.org/static/latest/phpmd.phar",
          "check_command": "phpmd --version",
          "install_command": "php phpmd.phar install --no-dev && mv phpmd.phar /usr/local/bin/phpmd",
          "description": "PHP Mess Detector, a tool for detecting potential problems in PHP code."
        },
        {
          "name": "PHP - CS",
          "url": "https://phars.phpcodesniffer.com/phpcs.phar",
          "check_command": "phpcs --version",
          "install_command": "php phpcs.phar install --no-dev && mv phpcs.phar /usr/local/bin/phpcs",
          "description": "PHP Code Sniffer, a tool for detecting violations of a defined coding standard in PHP code."
        },
        {
          "name": "PHP - CS Fixer",
          "url": "https://phars.phpcodesniffer.com/phpcbf.phar",
          "check_command": "php phpcbf --version",
          "install_command": "php phpcbf.phar install --no-dev && mv phpcbf.phar /usr/local/bin/phpcbf",
          "description": "PHP Code Beautifier and Fixer, a tool for automatically fixing coding standard violations in PHP code."
        }
      ]
    }
  }
}
